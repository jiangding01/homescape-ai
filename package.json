{
  "name": "homescape-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "asset:ingest": "node tools/asset-ingest.mjs",
    "asset:check-demo": "node tools/asset-ingest.mjs tools/fixtures/asset-ingestion/demo-release.json --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "floorplan:benchmark": "node tools/floorplan-benchmark.mjs tools/fixtures/floorplan-benchmark/manifest.json",
    "floorplan:extract": "tsx tools/floorplan-extract.ts",
    "floorplan:extract-demo": "tsx tools/floorplan-extract.ts tools/fixtures/floorplan-structured/company-plan-a.json .floorplan-benchmark/structured-plan-a.json",
    "floorplan:corpus": "node tools/floorplan-corpus.mjs",
    "floorplan:corpus:check-demo": "node tools/floorplan-corpus.mjs tools/fixtures/floorplan-benchmark/corpus.json --min-cases 2",
    "floorplan:pilot": "node tools/floorplan-pilot.mjs",
    "floorplan:pilot:check-demo": "node tools/floorplan-pilot.mjs tools/fixtures/floorplan-pilot/experiment.json --min-cases 2 --require-corpus-coverage --require-complete-review --require-complete-metadata",
    "floorplan:geometry": "tsx tools/floorplan-geometry-reconstruct.ts",
    "floorplan:geometry:check-demo": "tsx tools/floorplan-geometry-smoke.ts",
    "floorplan:raster": "tsx tools/floorplan-raster-extract.ts",
    "floorplan:raster:check-demo": "tsx packages/floorplan-extractor/src/node/raster-smoke.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
