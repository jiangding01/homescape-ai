PORT=3001
# 写接口尚无鉴权，默认只监听本机
HOST=127.0.0.1
# SQLite 设计状态库路径，缺省 apps/api/.data/homescape.sqlite；:memory: 为内存库。
HOMESCAPE_DB_PATH=
VITE_API_BASE_URL=/api

# Server-side only. Never expose this value through VITE_* variables.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Server-side only. Vision floor plan extractor (pnpm floorplan:vision); never use VITE_*.
ANTHROPIC_API_KEY=
